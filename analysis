import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import matplotlib.font_manager as fm
from matplotlib.ticker import StrMethodFormatter
from pathlib import Path
import zipfile
import subprocess
from IPython.display import display

print("===== 문제 2 분석 시작 =====")

# -----------------------------------------------------
# STEP 1. 분석할 CSV 파일
# -----------------------------------------------------

file = Path("/content/edu200_processed_final (5).csv")

if not file.exists():
    raise FileNotFoundError(
        "edu200_processed_final (5).csv를 업로드하세요."
    )

cols = [
    "PAT_AGE",
    "FOM_TP_CD",
    "CL_CD",
    "RVD_RPE_TAMT_AMT"
]

df2 = pd.read_csv(
    file,
    usecols=cols,
    dtype="string",
    encoding="utf-8-sig"
)

print("원본 건수:", f"{len(df2):,}")

# -----------------------------------------------------
# STEP 2. 분석 데이터 준비
# -----------------------------------------------------

# 의료비와 연령 숫자 변환
for col in ["PAT_AGE", "RVD_RPE_TAMT_AMT"]:
    df2[col] = pd.to_numeric(
        df2[col].str.replace(",", "", regex=False),
        errors="coerce"
    )

# 의료비가 없는 건 또는 음수 제외
df2 = df2.loc[
    df2["RVD_RPE_TAMT_AMT"].notna()
    & df2["RVD_RPE_TAMT_AMT"].ge(0)
].copy()

df2["의료비"] = df2["RVD_RPE_TAMT_AMT"]

# 연령대 만들기
# PAT_AGE는 5단위 기록이므로 10단위로 그룹화
df2["연령대숫자"] = (
    df2["PAT_AGE"] // 10 * 10
).astype("Int64")

df2["연령대"] = (
    df2["연령대숫자"].astype("string") + "대"
)

# 진료유형 코드 정리
codes = (
    df2["FOM_TP_CD"]
    .str.strip()
    .str.replace(r"\.0$", "", regex=True)
    .str.zfill(3)
)

df2["진료유형"] = codes.map({
    "021": "의과 입원",
    "031": "의과 외래"
}).fillna("기타 서식")

# 의료기관 종별 코드
df2["의료기관코드"] = (
    df2["CL_CD"].str.strip().fillna("미상")
)

# 고액 의료비 정의
cutoff = df2["의료비"].quantile(0.90)

df2["고액여부"] = (
    df2["의료비"] >= cutoff
).astype(int)

print("분석 건수:", f"{len(df2):,}")
print("고액 의료비 기준:", f"{cutoff:,.0f}원")

# -----------------------------------------------------
# STEP 3. 결과 저장 폴더
# -----------------------------------------------------

out = Path("/content/EDU200_문제2_최종분석")
out.mkdir(exist_ok=True)

# -----------------------------------------------------
# STEP 4. 한글 폰트
# -----------------------------------------------------

font_file = Path(
    "/usr/share/fonts/truetype/nanum/NanumGothic.ttf"
)

if not font_file.exists():
    subprocess.run(
        ["apt-get", "install", "-y", "-qq", "fonts-nanum"],
        check=True,
        stdout=subprocess.DEVNULL
    )

fm.fontManager.addfont(str(font_file))
font_name = fm.FontProperties(
    fname=str(font_file)
).get_name()

plt.rcParams["font.family"] = font_name
plt.rcParams["axes.unicode_minus"] = False

# -----------------------------------------------------
# STEP 5. 연령대 × 진료유형 교차분석
# -----------------------------------------------------

print("\n[1] 연령대 × 진료유형 교차분석")

cross = (
    df2.dropna(subset=["연령대"])
    .groupby(["연령대숫자", "연령대", "진료유형"])
    .agg(
        청구건수=("의료비", "size"),
        평균의료비=("의료비", "mean"),
        중앙값=("의료비", "median"),
        고액건수=("고액여부", "sum")
    )
    .reset_index()
    .sort_values(["연령대숫자", "진료유형"])
)

cross["고액비율(%)"] = (
    cross["고액건수"] / cross["청구건수"] * 100
)

cross = cross.drop(columns="연령대숫자")

display(
    cross.style.format({
        "청구건수": "{:,.0f}",
        "평균의료비": "{:,.0f}",
        "중앙값": "{:,.0f}",
        "고액건수": "{:,.0f}",
        "고액비율(%)": "{:.2f}%"
    }).hide(axis="index")
)

cross.to_csv(
    out / "01_연령대_진료유형_교차분석.csv",
    index=False,
    encoding="utf-8-sig"
)

# -----------------------------------------------------
# STEP 6. 평균 의료비 히트맵
# -----------------------------------------------------

print("\n[2] 평균 의료비 히트맵")

# 입원·외래만 표시
plot_cross = cross[
    cross["진료유형"].isin(["의과 입원", "의과 외래"])
]

heat = plot_cross.pivot(
    index="연령대",
    columns="진료유형",
    values="평균의료비"
)

heat = heat.reindex(
    columns=["의과 입원", "의과 외래"]
)

heat = heat.reindex(
    sorted(heat.index, key=lambda x: int(x.replace("대", "")))
)

fig, ax = plt.subplots(figsize=(9, 6))

values = heat.to_numpy(dtype=float)
masked = np.ma.masked_invalid(values)

im = ax.imshow(masked, cmap="Blues", aspect="auto")

ax.set_xticks(range(len(heat.columns)))
ax.set_xticklabels(heat.columns)

ax.set_yticks(range(len(heat.index)))
ax.set_yticklabels(heat.index)

for i in range(len(heat.index)):
    for j in range(len(heat.columns)):
        value = values[i, j]
        if np.isfinite(value):
            ax.text(
                j, i,
                f"{value:,.0f}원",
                ha="center",
                va="center",
                fontsize=10,
                color=(
                    "white"
                    if value > np.nanmax(values) * 0.65
                    else "#202020"
                )
            )

ax.set_title("연령대 × 진료유형별 평균 의료비", fontsize=15)
ax.set_xlabel("진료유형")
ax.set_ylabel("연령대")

cbar = fig.colorbar(im, ax=ax)
cbar.set_label("평균 의료비(원)")

plt.tight_layout()
plt.savefig(
    out / "02_연령대_진료유형_평균의료비_히트맵.png",
    dpi=180,
    bbox_inches="tight"
)
plt.show()
plt.close()

# -----------------------------------------------------
# STEP 7. 고액 의료비 집단의 공통 특성 분석
# -----------------------------------------------------

print("\n[3] 고액 의료비 집단 특성 분석")

combo = (
    df2.dropna(subset=["연령대"])
    .groupby(
        ["연령대", "진료유형", "의료기관코드"]
    )
    .agg(
        청구건수=("의료비", "size"),
        평균의료비=("의료비", "mean"),
        중앙값=("의료비", "median"),
        고액건수=("고액여부", "sum")
    )
    .reset_index()
)

combo["고액비율(%)"] = (
    combo["고액건수"] / combo["청구건수"] * 100
)

# 100건 미만 집단은 비율이 불안정할 수 있어
# 비교 순위에서는 제외하되 원본 집계표에는 남김
combo["비교대상여부"] = np.where(
    combo["청구건수"] >= 100,
    "비교대상",
    "소규모 집단"
)

combo.to_csv(
    out / "03_고액의료비_집단조합_전체.csv",
    index=False,
    encoding="utf-8-sig"
)

# 100건 이상 집단 중 비율 상위 15개
ranked = (
    combo[combo["청구건수"] >= 100]
    .sort_values(
        ["고액비율(%)", "청구건수"],
        ascending=[False, False]
    )
    .head(15)
    .copy()
)

print("\n고액 의료비 비율 상위 집단 15개")

display(
    ranked.style.format({
        "청구건수": "{:,.0f}",
        "평균의료비": "{:,.0f}",
        "중앙값": "{:,.0f}",
        "고액건수": "{:,.0f}",
        "고액비율(%)": "{:.2f}%"
    }).hide(axis="index")
)

ranked.to_csv(
    out / "04_고액의료비비율_상위15개_집단.csv",
    index=False,
    encoding="utf-8-sig"
)

# -----------------------------------------------------
# STEP 8. 고액 의료비 상위 집단 그래프
# -----------------------------------------------------

print("\n[4] 고액 의료비 집단 그래프")

if not ranked.empty:

    ranked = ranked.copy()

    ranked["집단명"] = (
        ranked["연령대"]
        + " / "
        + ranked["진료유형"]
        + " / 기관 "
        + ranked["의료기관코드"]
    )

    plot_rank = ranked.iloc[::-1]

    fig, ax = plt.subplots(figsize=(12, 8))

    bars = ax.barh(
        plot_rank["집단명"],
        plot_rank["고액비율(%)"],
        color="#3976B4"
    )

    ax.bar_label(
        bars,
        labels=[
            f"{v:.1f}% (N={n:,})"
            for v, n in zip(
                plot_rank["고액비율(%)"],
                plot_rank["청구건수"]
            )
        ],
        padding=4,
        fontsize=9
    )

    ax.set_xlim(
        0,
        max(plot_rank["고액비율(%)"]) * 1.35
    )

    ax.set_title(
        "고액 의료비 비율 상위 집단",
        fontsize=15
    )

    ax.set_xlabel("집단 내 고액 의료비 비율(%)")
    ax.set_ylabel("연령대 / 진료유형 / 의료기관 종별코드")

    ax.grid(axis="x", alpha=0.2)
    ax.set_axisbelow(True)

    plt.tight_layout()
    plt.savefig(
        out / "05_고액의료비_상위집단_그래프.png",
        dpi=180,
        bbox_inches="tight"
    )
    plt.show()
    plt.close()

# -----------------------------------------------------
# STEP 9. 결과 및 해석 자동 요약
# -----------------------------------------------------

print("\n[5] 결과 및 해석")

summary = []

summary.append("EDU200 의료비 관련 요인 탐색")
summary.append("=" * 45)

summary.append(
    f"분석 명세서 수: {len(df2):,}건"
)

summary.append(
    f"고액 의료비 기준: {cutoff:,.0f}원 이상"
)

summary.append(
    "고액 여부는 청구 건별 의료비의 전체 90백분위수로 정의함."
)

summary.append(
    "분석 단위는 환자 수가 아니라 청구 명세서 건수임."
)

if not cross.empty:
    # 표본이 100건 이상인 교차 집단에서 비교
    valid_cross = cross[cross["청구건수"] >= 100]

    if not valid_cross.empty:
        top_mean = valid_cross.loc[
            valid_cross["평균의료비"].idxmax()
        ]

        summary.append("")
        summary.append("[연령대와 진료유형 교차분석]")

        summary.append(
            f"평균 의료비가 가장 높은 집단: "
            f"{top_mean['연령대']} / {top_mean['진료유형']}"
        )

        summary.append(
            f"평균 의료비: {top_mean['평균의료비']:,.0f}원"
        )

if not ranked.empty:
    top_high = ranked.iloc[0]

    summary.append("")
    summary.append("[고액 의료비 집단 특성]")

    summary.append(
        f"고액 비율이 가장 높은 조합: "
        f"{top_high['연령대']} / "
        f"{top_high['진료유형']} / "
        f"의료기관코드 {top_high['의료기관코드']}"
    )

    summary.append(
        f"고액 의료비 비율: "
        f"{top_high['고액비율(%)']:.2f}%"
    )

    summary.append(
        f"해당 집단 청구 건수: "
        f"{top_high['청구건수']:,}건"
    )

summary.append("")
summary.append("[해석상 유의사항]")

summary.append(
    "1. 집단별 차이는 관련성을 보여주며 인과관계를 증명하지 않음."
)

summary.append(
    "2. 100건 미만 집단은 상위 비율 순위에서 제외함."
)

summary.append(
    "3. 의료기관 종별은 코드값이며 공식 코드표 확인이 필요함."
)

summary.append(
    "4. 90백분위수와 동일 금액이 여러 건이면 "
    "고액 집단 비율은 정확히 10%가 아닐 수 있음."
)

summary.append(
    "5. 이전 p-value 결과는 동일한 분석 대상과 "
    "검정 가정을 확인한 뒤 별도로 인용해야 함."
)

summary_text = "\n".join(summary)

print(summary_text)

(out / "06_문제2_결과및해석.txt").write_text(
    summary_text,
    encoding="utf-8"
)

