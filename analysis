import sys
import subprocess
import zipfile
from pathlib import Path

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import matplotlib.font_manager as fm

from matplotlib.ticker import StrMethodFormatter
from scipy.stats import mannwhitneyu, kruskal, spearmanr
from IPython.display import display

print("===== EDU200 파이널5 의료비 EDA 시작 =====")

# ------------------------------------------------------------
# STEP 1. 한글 폰트 준비
# ------------------------------------------------------------

font_path = Path(
    "/usr/share/fonts/truetype/nanum/NanumGothic.ttf"
)

if not font_path.exists():
    print("한글 폰트 설치 중...")
    subprocess.run(
        ["apt-get", "update", "-qq"],
        check=True,
        stdout=subprocess.DEVNULL
    )
    subprocess.run(
        ["apt-get", "install", "-y", "-qq", "fonts-nanum"],
        check=True,
        stdout=subprocess.DEVNULL
    )

# 그래프별로 실제 한글 폰트를 적용
font = fm.FontProperties(fname=str(font_path))

plt.rcParams["axes.unicode_minus"] = False
plt.rcParams["figure.dpi"] = 100

NAVY = "#23385F"
BLUE = "#3976B4"

def finish_chart(ax, filename):
    """한글 글꼴 적용 및 그래프 저장"""
    ax.title.set_fontproperties(font)
    ax.xaxis.label.set_fontproperties(font)
    ax.yaxis.label.set_fontproperties(font)

    for label in ax.get_xticklabels() + ax.get_yticklabels():
        label.set_fontproperties(font)

    ax.grid(axis="y", alpha=0.18)
    ax.set_axisbelow(True)

    plt.tight_layout()
    plt.savefig(out / filename, dpi=180, bbox_inches="tight")
    plt.show()
    plt.close()

print("한글 폰트 준비 완료")

# ------------------------------------------------------------
# STEP 2. 사용할 CSV 파일 지정
# ------------------------------------------------------------

filename = "edu200_processed_final (5).csv"

paths = [
    Path("/content") / filename,
    Path("/") / filename
]

source = next((p for p in paths if p.is_file()), None)

if source is None:
    print("현재 업로드된 파일:")
    for p in Path("/content").glob("*.csv"):
        print("-", p.name)

    raise FileNotFoundError(
        f"{filename} 파일을 코랩에 업로드하세요."
    )

print("사용 파일:", source)

# ------------------------------------------------------------
# STEP 3. 필요한 변수만 읽기
# ------------------------------------------------------------

required = [
    "RVD_RPE_TAMT_AMT",
    "FOM_TP_CD",
    "PAT_AGE"
]

raw = pd.read_csv(
    source,
    dtype="string",
    usecols=required,
    encoding="utf-8-sig"
)

raw.columns = raw.columns.str.strip()

# 비용 및 연령 숫자 변환
for column in ["RVD_RPE_TAMT_AMT", "PAT_AGE"]:
    raw[column] = pd.to_numeric(
        raw[column]
        .str.replace(",", "", regex=False)
        .str.strip(),
        errors="coerce"
    )

# 의료비 결측 및 음수 제외
data = raw.loc[
    raw["RVD_RPE_TAMT_AMT"].notna()
    & raw["RVD_RPE_TAMT_AMT"].ge(0)
].copy()

data["의료비"] = data["RVD_RPE_TAMT_AMT"]

if data.empty:
    raise ValueError("분석 가능한 의료비 데이터가 없습니다.")

print("\n===== 데이터 확인 =====")
print("원본 건수:", f"{len(raw):,}")
print("분석 건수:", f"{len(data):,}")
print("제외 건수:", f"{len(raw)-len(data):,}")

# 결과 저장 폴더
out = Path("/content/EDU200_파이널5_EDA_결과")
out.mkdir(parents=True, exist_ok=True)
# 이전 실행의 산출물이 남아있다면 이번 결과와 섞이지 않도록 제거
for old_file in out.glob("*.png"):
    old_file.unlink()
for old_file in out.glob("*.csv"):
    old_file.unlink()

# ------------------------------------------------------------
# STEP 4. 의료비 기초통계
# ------------------------------------------------------------

print("\n[1] 의료비 기초통계")

stats = data["의료비"].describe(
    percentiles=[.25, .5, .75, .90, .95, .99]
)

stats_table = stats.rename({
    "count": "건수",
    "mean": "평균",
    "std": "표준편차",
    "min": "최솟값",
    "25%": "25백분위",
    "50%": "중앙값",
    "75%": "75백분위",
    "90%": "90백분위",
    "95%": "95백분위",
    "99%": "99백분위",
    "max": "최댓값"
}).reset_index()

stats_table.columns = ["통계항목", "값"]

display(
    stats_table.style
    .format({"값": "{:,.2f}"})
    .hide(axis="index")
)

stats_table.to_csv(
    out / "01_의료비_기초통계.csv",
    index=False,
    encoding="utf-8-sig"
)

# ------------------------------------------------------------
# STEP 5. 의료비 히스토그램
# ------------------------------------------------------------

print("\n[2] 의료비 히스토그램")

p99 = data["의료비"].quantile(0.99)

# 그래프에서는 99백분위 이하만 표시
# 기초통계와 다른 검정에는 전체 유효 데이터를 사용
plot_cost = data.loc[
    data["의료비"] <= p99, "의료비"
].to_numpy(dtype=float)

fig, ax = plt.subplots(figsize=(10, 5))

ax.hist(
    plot_cost,
    bins=50,
    color=BLUE,
    edgecolor="white",
    linewidth=0.3
)

ax.set_title("의료비 지출 분포", fontsize=15)
ax.set_xlabel("의료비(원)", fontsize=12)
ax.set_ylabel("청구 건수(건)", fontsize=12)
ax.xaxis.set_major_formatter(StrMethodFormatter("{x:,.0f}"))
ax.yaxis.set_major_formatter(StrMethodFormatter("{x:,.0f}"))

finish_chart(ax, "02_의료비_히스토그램.png")

# ------------------------------------------------------------
# STEP 6. 로그변환 의료비 분포
# ------------------------------------------------------------

print("\n[3] 로그변환 의료비 분포")

log_cost = np.log1p(
    data["의료비"].to_numpy(dtype=float)
)

fig, ax = plt.subplots(figsize=(10, 5))

ax.hist(
    log_cost,
    bins=50,
    color=BLUE,
    edgecolor="white",
    linewidth=0.3
)

ax.set_title("로그변환 의료비 분포", fontsize=15)
ax.set_xlabel("로그변환 의료비(log(1 + 의료비))", fontsize=12)
ax.set_ylabel("청구 건수(건)", fontsize=12)
ax.yaxis.set_major_formatter(StrMethodFormatter("{x:,.0f}"))

finish_chart(ax, "03_의료비_로그분포.png")

# ------------------------------------------------------------
# STEP 7. 진료유형별 의료비 통계
# ------------------------------------------------------------

print("\n[4] 진료유형별 의료비 통계")

codes = (
    data["FOM_TP_CD"]
    .str.strip()
    .str.replace(r"\.0$", "", regex=True)
    .str.zfill(3)
)

# 의과 입원과 외래 코드 구분
data["진료유형"] = codes.map({
    "021": "의과 입원",
    "031": "의과 외래"
}).fillna("기타 서식")

group = (
    data.groupby("진료유형")
    .agg(
        건수=("의료비", "count"),
        평균의료비=("의료비", "mean"),
        중앙값=("의료비", "median"),
        총의료비=("의료비", "sum")
    )
    .reset_index()
)

display(
    group.style
    .format({
        "건수": "{:,.0f}",
        "평균의료비": "{:,.0f}",
        "중앙값": "{:,.0f}",
        "총의료비": "{:,.0f}"
    })
    .hide(axis="index")
)

group.to_csv(
    out / "04_진료유형별_의료비.csv",
    index=False,
    encoding="utf-8-sig"
)

# ------------------------------------------------------------
# STEP 8. 입원·외래 박스플롯
# ------------------------------------------------------------

print("\n[5] 입원·외래 박스플롯")

box_values = []
box_labels = []

for t, label in [
    ("의과 입원", "입원"),
    ("의과 외래", "외래")
]:
    values = data.loc[
        data["진료유형"] == t, "의료비"
    ]

    if not values.empty:
        # 그래프에만 최대 5천 건 표본 사용
        sample = values.sample(
            n=min(len(values), 5000),
            random_state=42
        )

        box_values.append(
            np.log1p(sample.to_numpy(dtype=float))
        )
        box_labels.append(label)

if len(box_values) == 2:

    fig, ax = plt.subplots(figsize=(9, 5))

    ax.boxplot(
        box_values,
        tick_labels=box_labels,
        showfliers=False,
        patch_artist=True,
        boxprops={"facecolor": "#DDE6F2"},
        medianprops={"color": "#C4682A", "linewidth": 2}
    )

    ax.set_title("입원·외래 의료비 분포 비교", fontsize=15)
    ax.set_xlabel("진료유형", fontsize=12)
    ax.set_ylabel(
        "로그변환 의료비(log(1 + 의료비))",
        fontsize=12
    )

    finish_chart(ax, "05_입원외래_박스플롯.png")

else:
    print("입원과 외래 데이터가 모두 없어 박스플롯 생략")

# ------------------------------------------------------------
# STEP 9. 연령대별 분석 데이터 준비
# ------------------------------------------------------------

print("\n[6] 연령대별 의료비 분석")

age_data = data.loc[
    data["PAT_AGE"].between(20, 79)
].copy()

age_data["연령대숫자"] = (
    age_data["PAT_AGE"] // 10 * 10
).astype(int)

age_data["연령대"] = (
    age_data["연령대숫자"].astype(str) + "대"
)

# 전체 의료비 데이터의 상위 10% 기준
high_cut = data["의료비"].quantile(0.90)

age_data["고액여부"] = (
    age_data["의료비"] >= high_cut
).astype(int)

print("고액 의료비 기준:", f"{high_cut:,.0f}원")
print("20~70대 분석 건수:", f"{len(age_data):,}")

age_result = (
    age_data.groupby(["연령대숫자", "연령대"])
    .agg(
        진료건수=("의료비", "count"),
        평균의료비=("의료비", "mean"),
        중앙값=("의료비", "median"),
        총의료비=("의료비", "sum"),
        고액건수=("고액여부", "sum")
    )
    .reset_index()
    .sort_values("연령대숫자")
)

age_result["고액비율(%)"] = (
    age_result["고액건수"]
    / age_result["진료건수"] * 100
)

age_result = age_result.drop(columns="연령대숫자")

display(
    age_result.style
    .format({
        "진료건수": "{:,.0f}",
        "평균의료비": "{:,.0f}",
        "중앙값": "{:,.0f}",
        "총의료비": "{:,.0f}",
        "고액건수": "{:,.0f}",
        "고액비율(%)": "{:.2f}%"
    })
    .hide(axis="index")
)

age_result.to_csv(
    out / "06_연령대별_의료비_통계.csv",
    index=False,
    encoding="utf-8-sig"
)

# ------------------------------------------------------------
# STEP 10. 연령대별 평균 의료비 그래프
# ------------------------------------------------------------

print("\n[7] 연령대별 평균 의료비 그래프")

fig, ax = plt.subplots(figsize=(10, 5))

bars = ax.bar(
    age_result["연령대"],
    age_result["평균의료비"],
    color=BLUE,
    width=0.65
)

ax.set_title("연령대별 평균 의료비", fontsize=15)
ax.set_xlabel("연령대", fontsize=12)
ax.set_ylabel("평균 의료비(원)", fontsize=12)

ax.yaxis.set_major_formatter(StrMethodFormatter("{x:,.0f}"))

ax.bar_label(
    bars,
    labels=[
        f"{v:,.0f}"
        for v in age_result["평균의료비"]
    ],
    padding=3,
    fontsize=9
)

ax.set_ylim(
    0,
    max(age_result["평균의료비"]) * 1.2
)

finish_chart(ax, "07_연령대별_평균의료비.png")

# ------------------------------------------------------------
# STEP 11. 연령대별 고액 의료비 비율
# ------------------------------------------------------------

print("\n[8] 연령대별 고액 의료비 비율")

fig, ax = plt.subplots(figsize=(10, 5))

bars = ax.bar(
    age_result["연령대"],
    age_result["고액비율(%)"],
    color=BLUE,
    width=0.65
)

ax.set_title("연령대별 고액 의료비 비율", fontsize=15)
ax.set_xlabel("연령대", fontsize=12)
ax.set_ylabel("고액 의료비 비율(%)", fontsize=12)

ax.bar_label(
    bars,
    labels=[
        f"{v:.2f}%"
        for v in age_result["고액비율(%)"]
    ],
    padding=3,
    fontsize=9
)

ax.set_ylim(
    0,
    max(age_result["고액비율(%)"]) * 1.2
)

finish_chart(ax, "08_연령대별_고액의료비비율.png")

# ------------------------------------------------------------
# STEP 12. p-value 통계검정
# ------------------------------------------------------------

print("\n[9] p-value 통계검정")

results = []

def add_test(name, method, statistic, p):
    results.append({
        "분석항목": name,
        "검정방법": method,
        "검정통계량": statistic,
        "p-value": p,
        "p-value 표시": (
            "p < 0.001" if p < 0.001
            else f"p = {p:.4f}"
        ),
        "통계적 유의성": (
            "유의" if p < 0.05
            else "유의하지 않음"
        )
    })

# 입원·외래 비교
inpatient = data.loc[
    data["진료유형"] == "의과 입원", "의료비"
].to_numpy(dtype=float)

outpatient = data.loc[
    data["진료유형"] == "의과 외래", "의료비"
].to_numpy(dtype=float)

if len(inpatient) > 0 and len(outpatient) > 0:
    u, p = mannwhitneyu(
        inpatient,
        outpatient,
        alternative="two-sided",
        method="asymptotic"
    )
    add_test(
        "입원·외래 의료비 차이",
        "Mann-Whitney U",
        u, p
    )

# 연령대별 차이
age_groups = [
    g["의료비"].to_numpy(dtype=float)
    for _, g in age_data.groupby("연령대숫자")
    if len(g) >= 2
]

if len(age_groups) >= 2:
    h, p = kruskal(*age_groups)

    add_test(
        "연령대별 의료비 차이",
        "Kruskal-Wallis",
        h, p
    )

# 연령과 의료비 순위상관
corr_data = data.loc[
    data["PAT_AGE"].between(0, 110)
].dropna(subset=["PAT_AGE", "의료비"])

if (
    len(corr_data) >= 3
    and corr_data["PAT_AGE"].nunique() >= 2
    and corr_data["의료비"].nunique() >= 2
):
    rho, p = spearmanr(
        corr_data["PAT_AGE"],
        corr_data["의료비"]
    )

    add_test(
        "연령과 의료비 상관관계",
        "Spearman",
        rho, p
    )

p_result = pd.DataFrame(results)

display(
    p_result.style
    .format({"검정통계량": "{:,.4f}"})
    .hide(axis="index")
)

p_result.to_csv(
    out / "09_의료비_pvalue_검정결과.csv",
    index=False,
    encoding="utf-8-sig"
)

# ------------------------------------------------------------
# STEP 13. 데이터 검증 결과
# ------------------------------------------------------------

print("\n[10] 최종 데이터 점검")

print("전체 분석 건수:", f"{len(data):,}")
print("연령대 분석 건수:", f"{len(age_data):,}")
print("입원 검정 건수:", f"{len(inpatient):,}")
print("외래 검정 건수:", f"{len(outpatient):,}")
print("의료비 최댓값:", f"{data['의료비'].max():,.0f}원")

maximum = data["의료비"].max()
max_count = (data["의료비"] == maximum).sum()

print("최댓값과 동일한 명세서 수:", f"{max_count:,}")

if max_count > 100:
    print(
        "주의: 최댓값에 많은 명세서가 집중되어 있습니다."
    )
    print(
        "원본 데이터나 전처리 과정의 상한 처리 여부를 확인하세요."
    )

# ------------------------------------------------------------
# STEP 14. 제출 파일 ZIP 저장
# ------------------------------------------------------------

print("\n===== 모든 분석 완료 =====")

zip_path = Path("/edu200_processed_final (5).csv")

with zipfile.ZipFile(
    zip_path, "w", zipfile.ZIP_DEFLATED
) as z:
    for file in sorted(out.iterdir()):
        if file.is_file():
            z.write(file, arcname=file.name)

print("결과 폴더:", out)
print("압축 파일:", zip_path)

print("\n생성된 파일:")
for p in sorted(out.iterdir()):
    print(" -", p.name)

print("\n===== 저장 완료 =====")


